# v2 as the main site at colnrg.app.
#
# This is an EXAMPLE, not the live config. The live file is
# /etc/nginx/sites-enabled/coln-dashboard on the droplet; see MIGRATION.md,
# which is the source of truth for the Sectigo cert, the :80 -> :443
# redirect and the security headers.
#
# History: v2 first went live alongside v1 at /new, v1 staying at /. The
# owner then asked for v2 to be the main site and v1 retired, so this is
# simpler than that first version was -- just point `root` at v2's build
# instead of v1's. v1's files are left in place on the droplet
# (/opt/coln-dashboard/frontend/dist), not deleted, just not referenced by
# this config any more. The backend is unaffected either way: main_v2:app
# has always served both /api and /api/v2 from one process.
#
# Only the `root` line and the addition of a /new redirect (for anyone who
# still has the old link) change from a plain v1 config. Everything else
# below -- the API proxying, the asset-cache regex, the SPA fallback -- was
# already generic to whatever `root` points at.

root /opt/coln-dashboard/frontend-v2/dist;

# Courtesy redirect for the /new link that was live before v2 became the
# main site (e.g. anyone who clicked the old v1 banner).
location ^~ /new/ {
    return 301 /;
}
location = /new {
    return 301 /;
}

location /api/ {
    limit_req zone=api burst=10 nodelay;
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
}

location / {
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "public, max-age=3600";
}

location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|pdf)$ {
    include /etc/nginx/security-headers.conf;
    expires 1y;
    add_header Cache-Control "public, immutable";
}
