# v2 as the main site at colnrg.app.
#
# This is an EXAMPLE, not the live config. The live file is
# /etc/nginx/sites-enabled/coln-dashboard on the droplet; see MIGRATION.md,
# which is the source of truth for the Sectigo cert, the :80 -> :443
# redirect and the security headers.
#
# History: v2 first went live alongside v1 at /new, v1 staying at /. The
# owner then asked for v2 to be the main site and v1 retired, so this is
# simpler than that first version was -- just point `root` at v2's build
# instead of v1's. v1's files are left in place on the droplet
# (/opt/coln-dashboard/frontend/dist), not deleted, just not referenced by
# this config any more. The backend is unaffected either way: main_v2:app
# has always served both /api and /api/v2 from one process.
#
# Only the `root` line and the addition of a /new redirect (for anyone who
# still has the old link) change from a plain v1 config. Everything else
# below -- the API proxying, the asset-cache regex, the SPA fallback -- was
# already generic to whatever `root` points at.

root /opt/coln-dashboard/frontend-v2/dist;

# Courtesy redirect for the /new link that was live before v2 became the
# main site (e.g. anyone who clicked the old v1 banner).
location ^~ /new/ {
    return 301 /;
}
location = /new {
    return 301 /;
}

# ^~ : anything under /api/ must reach the backend proxy even when it
# ends in an extension the regex location below would otherwise claim
# first (e.g. /api/v2/media/<sha>.jpg, the photo gallery's own route) --
# without ^~ here, nginx's longest-prefix-then-regex rule lets that
# regex win and the request 404s against the static root instead of
# being proxied. Found live, serving the photo gallery, 2026-09-17.
#
# The `api` zone (defined in nginx.conf's http block as
# `rate=10r/s`) covers every /api/v2/* read endpoint plus every photo
# thumbnail under /api/v2/media/ -- one page view fires a dozen-plus of
# these at once (overview, parameters, locations, rounds, downstream,
# several media thumbnails), and clicking through a few "Your place"
# locations multiplies that further. The zone started at 30r/m burst=10,
# sized for the costly `sync`/`reportgen` zones' logic rather than this
# one -- real browsing was tripping "This could not be loaded" within
# seconds. burst=60 nodelay covers a fast multi-location browsing
# session; 10r/s still caps a single IP well below anything that would
# trouble the backend. Found live, 2026-09-17.
location ^~ /api/ {
    limit_req zone=api burst=60 nodelay;
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
}

location / {
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "public, max-age=3600";
}

location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|pdf)$ {
    include /etc/nginx/security-headers.conf;
    expires 1y;
    add_header Cache-Control "public, immutable";
}
