[Unit]
Description=Coln River Guardians Dashboard API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/coln-dashboard/backend

Environment=PATH=/opt/coln-dashboard/backend/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/coln-dashboard/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2

Restart=on-failure
RestartSec=5
StartLimitBurst=3

RuntimeMaxSec=86400

[Install]
WantedBy=multi-user.target
